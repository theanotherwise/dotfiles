#!/bin/bash

SCRIPT_DIR_PATH="$(dirname "$(realpath "$0")")"

DOTFILES_FILES_PATH="${HOME}/.dotfiles.files"
DOTFILES_FILES_DIRECTORIES=(
    "kubeconfig"
)

for directory in "${DOTFILES_FILES_DIRECTORIES[@]}"; do
    mkdir -p "${DOTFILES_FILES_PATH}/${directory}"
done

python3 "${SCRIPT_DIR_PATH}/.dotfiles.d/dotfiles.py"

sc_helper_dot_confirm_discard() {
  local answer
  local label="${2:-repository}"
  local repo_dir="${1:-}"
  local status_output
  local -a status_args=()

  [ -n "${repo_dir}" ] || return 2

  if [ "${3:-}" = "ignore-submodules" ]; then
    status_args=(--ignore-submodules=all)
  fi

  status_output="$(command git -C "${repo_dir}" status --porcelain "${status_args[@]}")" || return 1

  if [ -n "${status_output}" ]; then
    printf 'Local changes in %s:\n\n' "${label}"
    command git -C "${repo_dir}" status --short "${status_args[@]}"
    command git -C "${repo_dir}" diff --cached --no-ext-diff "${status_args[@]}" -- .
    command git -C "${repo_dir}" diff --no-ext-diff "${status_args[@]}" -- .

    printf '%s\n' \
      '' \
      'Untracked files and directories that will be removed:'
    command git -C "${repo_dir}" clean -nd
    printf '\nDiscard all local changes shown above in %s? [y/N] ' "${label}"
    IFS= read -r answer

    case "${answer}" in
      y|Y|yes|YES|Yes)
        command git -C "${repo_dir}" restore --source=HEAD --staged --worktree -- . || return 1
        command git -C "${repo_dir}" clean -fd || return 1
        ;;
      *)
        printf '%s\n' 'Cancelled. No local changes were removed.'
        return 1
        ;;
    esac
  fi
}

sc_helper_dot_sync() {
  local skills_dir="${HOME}/.dot/ai-skills"

  sc_helper_dot_confirm_discard "${HOME}" "dot" "ignore-submodules" || return 1
  command git -C "${HOME}" pull --ff-only --recurse-submodules=no origin main || return 1

  if command git -C "${skills_dir}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    sc_helper_dot_confirm_discard "${skills_dir}" "dot/ai-skills" || return 1
  fi

  command git -C "${HOME}" submodule sync --recursive -- ".dot/ai-skills" || return 1
  command git -C "${HOME}" submodule update --init --remote --recursive -- ".dot/ai-skills" || return 1
  command git -C "${skills_dir}" status --short --branch
  sc_helper_dotcache
}


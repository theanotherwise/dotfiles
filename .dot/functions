sc_helper_bashrc_git_dir() {
  local dir git_dir line

  dir="${PWD:-}"
  [ -n "${dir}" ] || return 1

  while [ -n "${dir}" ]; do
    if [ -d "${dir}/.git" ]; then
      SC_BASHRC_GIT_DIR="${dir}/.git"
      printf "%s\n" "${dir}/.git"
      return 0
    fi

    if [ -f "${dir}/.git" ]; then
      IFS= read -r line <"${dir}/.git" || return 1
      case "${line}" in
        gitdir:\ /*)
          git_dir="${line#gitdir: }"
          ;;
        gitdir:\ *)
          git_dir="${dir}/${line#gitdir: }"
          ;;
        *)
          return 1
          ;;
      esac

      [ -d "${git_dir}" ] || return 1
      SC_BASHRC_GIT_DIR="${git_dir}"
      printf "%s\n" "${git_dir}"
      return 0
    fi

    [ "${dir}" = "/" ] && break
    dir="${dir%/*}"
    [ -n "${dir}" ] || dir="/"
  done

  return 1
}

sc_helper_bashrc_branch() {
  local branch git_dir head

  SC_BASHRC_GIT_DIR=""
  sc_helper_bashrc_git_dir >/dev/null || return 0
  git_dir="${SC_BASHRC_GIT_DIR}"
  [ -n "${git_dir}" ] || return 0
  [ -r "${git_dir}/HEAD" ] || return 0
  IFS= read -r head <"${git_dir}/HEAD" || return 0

  case "${head}" in
    ref:\ refs/heads/*)
      branch="${head#ref: refs/heads/}"
      ;;
    ref:\ *)
      branch="${head#ref: }"
      branch="${branch##*/}"
      ;;
    "")
      return 0
      ;;
    *)
      branch="${head:0:7}"
      ;;
  esac

  [ -n "${branch}" ] && printf "(%s) " "${branch}"
}


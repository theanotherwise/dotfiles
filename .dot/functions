sc_helper_kube_namespaces() {
  local namespaces resource_rows rows

  if [ "$#" -ne 0 ]; then
    printf '%s\n' 'Usage: kd-ns' >&2
    return 2
  fi
  if ! command -v kubectl >/dev/null 2>&1; then
    printf '%s\n' 'kubectl not found' >&2
    return 127
  fi

  namespaces="$(command kubectl get namespaces --no-headers)" || {
    printf '%s\n' 'Could not list Kubernetes namespaces' >&2
    return 1
  }
  resource_rows="$(command kubectl get pods,persistentvolumeclaims --all-namespaces --no-headers -o 'custom-columns=KIND:.kind,NAMESPACE:.metadata.namespace,STORAGE:.spec.resources.requests.storage')" || {
    printf '%s\n' 'Could not list Kubernetes pods and PVCs' >&2
    return 1
  }

  rows="$({
    printf '%s\n' "${resource_rows}"
    printf '%s\n' '__DOT_NAMESPACE_ROWS__'
    printf '%s\n' "${namespaces}"
  } | awk '
      function quantity_bytes(quantity, multiplier) {
        multiplier = 1
        if (quantity ~ /Ei$/) { sub(/Ei$/, "", quantity); multiplier = 1152921504606846976 }
        else if (quantity ~ /Pi$/) { sub(/Pi$/, "", quantity); multiplier = 1125899906842624 }
        else if (quantity ~ /Ti$/) { sub(/Ti$/, "", quantity); multiplier = 1099511627776 }
        else if (quantity ~ /Gi$/) { sub(/Gi$/, "", quantity); multiplier = 1073741824 }
        else if (quantity ~ /Mi$/) { sub(/Mi$/, "", quantity); multiplier = 1048576 }
        else if (quantity ~ /Ki$/) { sub(/Ki$/, "", quantity); multiplier = 1024 }
        else if (quantity ~ /E$/) { sub(/E$/, "", quantity); multiplier = 1000000000000000000 }
        else if (quantity ~ /P$/) { sub(/P$/, "", quantity); multiplier = 1000000000000000 }
        else if (quantity ~ /T$/) { sub(/T$/, "", quantity); multiplier = 1000000000000 }
        else if (quantity ~ /G$/) { sub(/G$/, "", quantity); multiplier = 1000000000 }
        else if (quantity ~ /M$/) { sub(/M$/, "", quantity); multiplier = 1000000 }
        else if (quantity ~ /[kK]$/) { sub(/[kK]$/, "", quantity); multiplier = 1000 }
        else if (quantity ~ /m$/) { sub(/m$/, "", quantity); multiplier = 0.001 }
        return (quantity + 0) * multiplier
      }
      $0 == "__DOT_NAMESPACE_ROWS__" { reading_namespaces = 1; next }
      !reading_namespaces {
        if ($1 == "Pod") {
          pod_counts[$2]++
        } else if ($1 == "PersistentVolumeClaim") {
          pvc_counts[$2]++
          pvc_bytes[$2] += quantity_bytes($3)
        }
        next
      }
      !NF { next }
      {
        if ($1 == "default" || $1 ~ /^kube-/) {
          group_order = 2
          group = "kube"
        } else if ($1 ~ /gke/) {
          group_order = 3
          group = "gke"
        } else if ($1 ~ /-system$/) {
          group_order = 0
          group = "system"
        } else if ($1 ~ /-operator$/) {
          group_order = 1
          group = "operator"
        } else {
          split($1, name_parts, "-")
          group_order = 4
          group = "group:" name_parts[1]
        }
        printf "%d\t%s\t%s\t%s\t%s\t%d\t%d\t%.0f\n", group_order, group, $1, $2, $3, pod_counts[$1] + 0, pvc_counts[$1] + 0, pvc_bytes[$1] + 0
      }
    ' | LC_ALL=C sort -t "$(printf '\t')" -k1,1n -k2,2 -k3,3)"

  [ -n "${rows}" ] || return 0

  printf '%s\n' "${rows}" | awk -F '\t' '
    function repeated(character, count, result, position) {
      result = ""
      for (position = 0; position < count; position++) {
        result = result character
      }
      return result
    }
    function compact_number(value, result) {
      result = sprintf("%.2f", value)
      sub(/0+$/, "", result)
      sub(/\.$/, "", result)
      return result
    }
    function storage_size(bytes) {
      if (bytes >= 1152921504606846976) return compact_number(bytes / 1152921504606846976) "Ei"
      if (bytes >= 1125899906842624) return compact_number(bytes / 1125899906842624) "Pi"
      if (bytes >= 1099511627776) return compact_number(bytes / 1099511627776) "Ti"
      if (bytes >= 1073741824) return compact_number(bytes / 1073741824) "Gi"
      if (bytes >= 1048576) return compact_number(bytes / 1048576) "Mi"
      if (bytes >= 1024) return compact_number(bytes / 1024) "Ki"
      return sprintf("%.0fB", bytes)
    }
    function separator(title, prefix, plain_prefix) {
      plain_prefix = "--[ " title " ]"
      prefix = "--[ " blue title reset " ]"
      printf "%s%s+%s+%s+%s+%s+%s\n", prefix, repeated("-", name_width + 1 - length(plain_prefix)), repeated("-", status_width + 2), repeated("-", age_width + 2), repeated("-", pods_width + 2), repeated("-", pvc_width + 2), repeated("-", storage_width + 1)
    }
    BEGIN {
      blue = sprintf("%c[34m", 27)
      reset = sprintf("%c[0m", 27)
    }
    {
      groups[NR] = $2
      names[NR] = $3
      statuses[NR] = $4
      ages[NR] = $5
      pod_labels[NR] = $6 ($6 == 1 ? " pod" : " pods")
      pvc_labels[NR] = $7 " pvc"
      storage_labels[NR] = storage_size($8 + 0)
      if (length($3) > name_width) {
        name_width = length($3)
      }
      if (length($2) + 5 > name_width) {
        name_width = length($2) + 5
      }
      if (length($4) > status_width) {
        status_width = length($4)
      }
      if (length($5) > age_width) {
        age_width = length($5)
      }
      if (length(pod_labels[NR]) > pods_width) {
        pods_width = length(pod_labels[NR])
      }
      if (length(pvc_labels[NR]) > pvc_width) {
        pvc_width = length(pvc_labels[NR])
      }
      if (length(storage_labels[NR]) > storage_width) {
        storage_width = length(storage_labels[NR])
      }
    }
    END {
      for (row = 1; row <= NR; row++) {
        if (row == 1 || groups[row] != groups[row - 1]) {
          separator(groups[row])
        }
        printf "%-*s | %-*s | %-*s | %-*s | %-*s | %-*s\n", name_width, names[row], status_width, statuses[row], age_width, ages[row], pods_width, pod_labels[row], pvc_width, pvc_labels[row], storage_width, storage_labels[row]
      }
    }
  '
}

sc_helper_kube_pod_resource_rows() {
  command jq -r '
    def cpu_m:
      (. // "0" | tostring) as $quantity
      | if $quantity | endswith("n") then ($quantity[0:-1] | tonumber) / 1000000
        elif $quantity | endswith("u") then ($quantity[0:-1] | tonumber) / 1000
        elif $quantity | endswith("m") then ($quantity[0:-1] | tonumber)
        else ($quantity | tonumber) * 1000
        end;

    def memory_bytes:
      (. // "0" | tostring) as $quantity
      | if $quantity | endswith("Ei") then ($quantity[0:-2] | tonumber) * 1152921504606846976
        elif $quantity | endswith("Pi") then ($quantity[0:-2] | tonumber) * 1125899906842624
        elif $quantity | endswith("Ti") then ($quantity[0:-2] | tonumber) * 1099511627776
        elif $quantity | endswith("Gi") then ($quantity[0:-2] | tonumber) * 1073741824
        elif $quantity | endswith("Mi") then ($quantity[0:-2] | tonumber) * 1048576
        elif $quantity | endswith("Ki") then ($quantity[0:-2] | tonumber) * 1024
        elif $quantity | endswith("E") then ($quantity[0:-1] | tonumber) * 1000000000000000000
        elif $quantity | endswith("P") then ($quantity[0:-1] | tonumber) * 1000000000000000
        elif $quantity | endswith("T") then ($quantity[0:-1] | tonumber) * 1000000000000
        elif $quantity | endswith("G") then ($quantity[0:-1] | tonumber) * 1000000000
        elif $quantity | endswith("M") then ($quantity[0:-1] | tonumber) * 1000000
        elif $quantity | endswith("K") then ($quantity[0:-1] | tonumber) * 1000
        elif $quantity | endswith("m") then ($quantity[0:-1] | tonumber) / 1000
        else ($quantity | tonumber)
        end;

    def container_cpu($container; $kind):
      (((($container.resources // {})[$kind] // {}).cpu // "0") | cpu_m);

    def container_memory($container; $kind):
      (((($container.resources // {})[$kind] // {}).memory // "0") | memory_bytes);

    def summed_cpu($containers; $kind):
      reduce $containers[] as $container (0; . + container_cpu($container; $kind));

    def summed_memory($containers; $kind):
      reduce $containers[] as $container (0; . + container_memory($container; $kind));

    def container_pod_cpu($pod; $kind):
      (summed_cpu(($pod.spec.containers // []); $kind)) as $running
      | reduce ($pod.spec.initContainers // [])[] as $container (
          {running: $running, restartable: 0, init_max: 0};
          (container_cpu($container; $kind)) as $value
          | if $container.restartPolicy == "Always" then
              .running += $value
              | .restartable += $value
              | .init_max = ([.init_max, .restartable] | max)
            else
              .init_max = ([.init_max, (.restartable + $value)] | max)
            end
        )
      | [.running, .init_max] | max;

    def container_pod_memory($pod; $kind):
      (summed_memory(($pod.spec.containers // []); $kind)) as $running
      | reduce ($pod.spec.initContainers // [])[] as $container (
          {running: $running, restartable: 0, init_max: 0};
          (container_memory($container; $kind)) as $value
          | if $container.restartPolicy == "Always" then
              .running += $value
              | .restartable += $value
              | .init_max = ([.init_max, .restartable] | max)
            else
              .init_max = ([.init_max, (.restartable + $value)] | max)
            end
        )
      | [.running, .init_max] | max;

    def pod_cpu($pod; $kind):
      (((($pod.spec.resources // {})[$kind] // {}).cpu // null)) as $pod_level
      | (if $pod_level != null then ($pod_level | cpu_m)
         else container_pod_cpu($pod; $kind)
         end) as $value
      | if $kind == "limits" and $value == 0 then 0
        else $value + (($pod.spec.overhead.cpu // "0") | cpu_m)
        end;

    def pod_memory($pod; $kind):
      (((($pod.spec.resources // {})[$kind] // {}).memory // null)) as $pod_level
      | (if $pod_level != null then ($pod_level | memory_bytes)
         else container_pod_memory($pod; $kind)
         end) as $value
      | if $kind == "limits" and $value == 0 then 0
        else $value + (($pod.spec.overhead.memory // "0") | memory_bytes)
        end;

    def rounded_thousandths:
      ((. * 1000 | round) / 1000);

    def rounded_hundredths:
      ((. * 100 | round) / 100);

    def format_cpu:
      if . == 0 then "0"
      else (rounded_thousandths | tostring) + "m"
      end;

    def format_memory:
      . as $bytes
      | if $bytes == 0 then "0B"
        elif $bytes >= 1152921504606846976 then (($bytes / 1152921504606846976 | rounded_hundredths | tostring) + "Ei")
        elif $bytes >= 1125899906842624 then (($bytes / 1125899906842624 | rounded_hundredths | tostring) + "Pi")
        elif $bytes >= 1099511627776 then (($bytes / 1099511627776 | rounded_hundredths | tostring) + "Ti")
        elif $bytes >= 1073741824 then (($bytes / 1073741824 | rounded_hundredths | tostring) + "Gi")
        elif $bytes >= 1048576 then (($bytes / 1048576 | rounded_hundredths | tostring) + "Mi")
        elif $bytes >= 1024 then (($bytes / 1024 | rounded_hundredths | tostring) + "Ki")
        else (($bytes | rounded_hundredths | tostring) + "B")
        end;

    (if has("items") then .items[] else . end) as $pod
    | [
        ($pod.metadata.namespace // "default"),
        $pod.metadata.name,
        (pod_cpu($pod; "requests") | format_cpu),
        (pod_memory($pod; "requests") | format_memory),
        (pod_cpu($pod; "limits") | format_cpu),
        (pod_memory($pod; "limits") | format_memory)
      ]
    | @tsv
  '
}

sc_helper_kube_pods() {
  if ! command -v kubectl >/dev/null 2>&1; then
    printf '%s\n' 'kubectl not found' >&2
    return 127
  fi
  if ! command -v jq >/dev/null 2>&1; then
    printf '%s\n' 'jq not found' >&2
    return 127
  fi

  local all_namespaces=0 no_headers=0 passthrough=0
  local arg output_value="" pods_json native_rows resource_rows
  local index=0
  local -a native_args json_args

  native_args=("$@")
  while [ "${index}" -lt "${#native_args[@]}" ]; do
    arg="${native_args[index]}"
    case "${arg}" in
      -A|--all-namespaces|--all-namespaces=true)
        all_namespaces=1
        ;;
      --all-namespaces=false)
        all_namespaces=0
        ;;
      --no-headers|--no-headers=true)
        no_headers=1
        ;;
      --no-headers=false)
        no_headers=0
        ;;
      -o|--output)
        if [ $((index + 1)) -ge "${#native_args[@]}" ]; then
          passthrough=1
        else
          output_value="${native_args[index + 1]}"
          index=$((index + 1))
        fi
        ;;
      -o=*|--output=*)
        output_value="${arg#*=}"
        ;;
      -o?*)
        output_value="${arg#-o}"
        ;;
      -w|--watch|--watch=true|--watch-only|--watch-only=true|-h|--help)
        passthrough=1
        ;;
    esac
    index=$((index + 1))
  done

  if [ -n "${output_value}" ] && [ "${output_value}" != "wide" ]; then
    passthrough=1
  fi
  if [ "${passthrough}" -eq 1 ]; then
    command kubectl get pods "${native_args[@]}"
    return
  fi

  index=0
  while [ "${index}" -lt "${#native_args[@]}" ]; do
    arg="${native_args[index]}"
    case "${arg}" in
      -o|--output|-L|--label-columns)
        index=$((index + 1))
        ;;
      -o=*|--output=*|-o?*|-L=*|-L?*|--label-columns=*|--no-headers|--no-headers=*|--show-kind|--show-kind=*|--show-labels|--show-labels=*|--server-print|--server-print=*|--use-openapi-print-columns|--use-openapi-print-columns=*)
        ;;
      *)
        json_args+=("${arg}")
        ;;
    esac
    index=$((index + 1))
  done

  native_rows="$(command kubectl get pods "${native_args[@]}")" || return
  [ -n "${native_rows}" ] || return 0
  case "${native_rows}" in
    'No resources found'*)
      printf '%s\n' "${native_rows}"
      return 0
      ;;
  esac

  pods_json="$(command kubectl get pods "${json_args[@]}" -o json)" || return
  resource_rows="$(printf '%s' "${pods_json}" | sc_helper_kube_pod_resource_rows)" || return

  {
    printf '%s\n' "${resource_rows}"
    printf '%s\n' '__DOT_KUBE_PODS_TABLE__'
    printf '%s\n' "${native_rows}"
  } | awk -F '\t' -v all_namespaces="${all_namespaces}" -v no_headers="${no_headers}" '
    function update_width(value, current) {
      return length(value) > current ? length(value) : current
    }
    function truncated(value, limit, available, left, right) {
      if (length(value) <= limit) {
        return value
      }
      available = limit - 3
      left = int((available + 1) / 2)
      right = available - left
      return substr(value, 1, left) "..." substr(value, length(value) - right + 1)
    }
    function repeated(character, count, result, position) {
      result = ""
      for (position = 0; position < count; position++) {
        result = result character
      }
      return result
    }
    function separator(namespace, display, plain_prefix, colored_prefix, column) {
      display = truncated(namespace, namespace_name_limit)
      plain_prefix = "--[ " display " ]"
      colored_prefix = "--[ " blue display reset " ]"
      printf "%s%s", colored_prefix, repeated("-", widths[1] + 1 - length(plain_prefix))
      for (column = 2; column <= column_count; column++) {
        printf "+%s", repeated("-", widths[column] + 2)
      }
      printf "\n"
    }
    BEGIN {
      pod_name_limit = 48
      namespace_name_limit = 32
      blue = sprintf("%c[34m", 27)
      reset = sprintf("%c[0m", 27)
    }
    $0 == "__DOT_KUBE_PODS_TABLE__" {
      reading_table = 1
      next
    }
    !reading_table {
      if (!NF) next
      key = all_namespaces ? $1 "/" $2 : $2
      cpu_requests[key] = $3
      memory_requests[key] = $4
      cpu_limits[key] = $5
      memory_limits[key] = $6
      namespaces[key] = $1
      next
    }
    {
      if (!header_seen && !no_headers) {
        header_seen = 1
        next
      }
      header_seen = 1

      native_column_count = split($0, native_cells, /[[:space:]][[:space:]]+/)
      native_name_column = all_namespaces ? 2 : 1
      namespace = all_namespaces ? native_cells[1] : ""
      name = native_cells[native_name_column]
      sub("^pod/", "", name)
      key = all_namespaces ? namespace "/" name : name
      if (key in namespaces) {
        namespace = namespaces[key]
      } else if (!all_namespaces) {
        namespace = "default"
      }

      row = ++table_count
      output_column = 0
      for (native_column = 1; native_column <= native_column_count; native_column++) {
        if (all_namespaces && native_column == 1) {
          continue
        }
        value = native_cells[native_column]
        if (native_column == native_name_column) {
          value = truncated(value, pod_name_limit)
        }
        row_values[row, ++output_column] = value
        widths[output_column] = update_width(value, widths[output_column])
      }

      if (key in cpu_requests) {
        cpu_request = cpu_requests[key]
        memory_request = memory_requests[key]
        cpu_limit = cpu_limits[key]
        memory_limit = memory_limits[key]
      } else {
        cpu_request = "-"
        memory_request = "-"
        cpu_limit = "-"
        memory_limit = "-"
      }
      row_values[row, ++output_column] = cpu_request
      widths[output_column] = update_width(cpu_request, widths[output_column])
      row_values[row, ++output_column] = memory_request
      widths[output_column] = update_width(memory_request, widths[output_column])
      row_values[row, ++output_column] = cpu_limit
      widths[output_column] = update_width(cpu_limit, widths[output_column])
      row_values[row, ++output_column] = memory_limit
      widths[output_column] = update_width(memory_limit, widths[output_column])

      row_namespaces[row] = namespace
      column_count = output_column > column_count ? output_column : column_count
      namespace_width = length(truncated(namespace, namespace_name_limit)) + 5
      if (namespace_width > widths[1]) {
        widths[1] = namespace_width
      }
    }
    END {
      for (row = 1; row <= table_count; row++) {
        if (row == 1 || row_namespaces[row] != row_namespaces[row - 1]) {
          separator(row_namespaces[row])
        }
        printf "%-*s", widths[1], row_values[row, 1]
        for (column = 2; column <= column_count; column++) {
          printf " | %-*s", widths[column], row_values[row, column]
        }
        printf "\n"
      }
    }
  '
}

sc_helper_kube_events() {
  if ! command -v kubectl >/dev/null 2>&1; then
    printf '%s\n' 'kubectl not found' >&2
    return 127
  fi
  if ! command -v jq >/dev/null 2>&1; then
    printf '%s\n' 'jq not found' >&2
    return 127
  fi

  local passthrough=0 output_value="" arg events_json event_rows
  local index=0
  local -a native_args json_args

  native_args=("$@")
  while [ "${index}" -lt "${#native_args[@]}" ]; do
    arg="${native_args[index]}"
    case "${arg}" in
      -o|--output)
        passthrough=1
        index=$((index + 1))
        ;;
      -o=*|--output=*)
        output_value="${arg#*=}"
        ;;
      -o?*)
        output_value="${arg#-o}"
        ;;
      -w|--watch|--watch=true|--watch-only|--watch-only=true|-h|--help)
        passthrough=1
        ;;
    esac
    index=$((index + 1))
  done
  [ -z "${output_value}" ] || passthrough=1

  if [ "${passthrough}" -eq 1 ]; then
    command kubectl get events "${native_args[@]}" --sort-by=.metadata.creationTimestamp
    return
  fi

  index=0
  while [ "${index}" -lt "${#native_args[@]}" ]; do
    arg="${native_args[index]}"
    case "${arg}" in
      --sort-by|-o|--output|-L|--label-columns)
        index=$((index + 1))
        ;;
      --sort-by=*|-o=*|--output=*|-o?*|-L=*|-L?*|--label-columns=*|--no-headers|--no-headers=*|--show-kind|--show-kind=*|--show-labels|--show-labels=*|--server-print|--server-print=*|--use-openapi-print-columns|--use-openapi-print-columns=*)
        ;;
      *)
        json_args+=("${arg}")
        ;;
    esac
    index=$((index + 1))
  done

  events_json="$(command kubectl get events "${json_args[@]}" -o json)" || return
  event_rows="$({
    printf '%s' "${events_json}" | command jq -r '
      def created:
        (.metadata.creationTimestamp // "-")
        | if . == "-" then .
          else gsub("T"; " ") | sub("\\.[0-9]+Z$"; "Z")
          end;

      (if has("items") then .items else [.] end)
      | sort_by([(.metadata.namespace // "default"), (.metadata.creationTimestamp // "")])[]
      | . as $event
      | ($event.regarding // $event.involvedObject // {}) as $object
      | [
          ($event.metadata.namespace // "default"),
          ($event | created),
          ($event.type // "-"),
          ($event.reason // "-"),
          (($object.kind // "-") + "/" + ($object.name // "-")),
          (($event.series.count // $event.count // $event.deprecatedCount // 1) | tostring),
          ($event.note // $event.message // "-")
        ]
      | @tsv
    '
  })" || return

  if [ -z "${event_rows}" ]; then
    printf '%s\n' 'No events found'
    return 0
  fi

  printf '%s\n' "${event_rows}" | awk -F '\t' '
    function update_width(value, current) {
      return length(value) > current ? length(value) : current
    }
    function truncated_middle(value, limit, available, left, right) {
      if (length(value) <= limit) {
        return value
      }
      available = limit - 3
      left = int((available + 1) / 2)
      right = available - left
      return substr(value, 1, left) "..." substr(value, length(value) - right + 1)
    }
    function truncated_end(value, limit) {
      if (length(value) <= limit) {
        return value
      }
      return substr(value, 1, limit - 3) "..."
    }
    function repeated(character, count, result, position) {
      result = ""
      for (position = 0; position < count; position++) {
        result = result character
      }
      return result
    }
    function separator(namespace, display, plain_prefix, colored_prefix, column) {
      display = truncated_middle(namespace, namespace_name_limit)
      plain_prefix = "--[ " display " ]"
      colored_prefix = "--[ " blue display reset " ]"
      printf "%s%s", colored_prefix, repeated("-", widths[1] + 1 - length(plain_prefix))
      for (column = 2; column <= column_count; column++) {
        printf "+%s", repeated("-", widths[column] + 2)
      }
      printf "\n"
    }
    BEGIN {
      namespace_name_limit = 32
      reason_limit = 28
      object_limit = 44
      message_limit = 72
      column_count = 6
      blue = sprintf("%c[34m", 27)
      reset = sprintf("%c[0m", 27)
    }
    {
      row = ++row_count
      namespaces[row] = $1
      values[row, 1] = $2
      values[row, 2] = $3
      values[row, 3] = truncated_end($4, reason_limit)
      values[row, 4] = truncated_middle($5, object_limit)
      values[row, 5] = $6 "x"
      values[row, 6] = truncated_end($7, message_limit)

      for (column = 1; column <= column_count; column++) {
        widths[column] = update_width(values[row, column], widths[column])
      }
      namespace_width = length(truncated_middle($1, namespace_name_limit)) + 5
      if (namespace_width > widths[1]) {
        widths[1] = namespace_width
      }
    }
    END {
      for (row = 1; row <= row_count; row++) {
        if (row == 1 || namespaces[row] != namespaces[row - 1]) {
          separator(namespaces[row])
        }
        printf "%-*s", widths[1], values[row, 1]
        for (column = 2; column <= column_count; column++) {
          printf " | %-*s", widths[column], values[row, column]
        }
        printf "\n"
      }
    }
  '
}

sc_helper_kube_capacity() {
  local rows mode namespace

  mode="nodes"
  namespace=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -c|--controllers)
        mode="controllers"
        shift
        ;;
      -n|--namespace)
        if [ -z "${2:-}" ]; then
          printf '%s\n' 'Usage: kc [-c] [-n namespace]' >&2
          return 2
        fi
        namespace="$2"
        shift 2
        ;;
      -h|--help)
        printf '%s\n' \
          'Usage: kc' \
          '       kc -c [-n namespace]' \
          '' \
          'kc       cluster and per-node requests and limits' \
          'kc -c    Deployment, StatefulSet, and DaemonSet totals in a namespace'
        return 0
        ;;
      *)
        printf '%s\n' 'Usage: kc [-c] [-n namespace]' >&2
        return 2
        ;;
    esac
  done

  if [ "${mode}" = "nodes" ] && [ -n "${namespace}" ]; then
    printf '%s\n' 'The namespace option requires -c' >&2
    return 2
  fi

  if ! command -v kubectl >/dev/null 2>&1; then
    printf '%s\n' 'kubectl not found' >&2

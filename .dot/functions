sc_helper_bashrc_kube_label_from_file() {
  awk '
    function clean(value) {
      sub(/^[[:space:]]+/, "", value)
      sub(/[[:space:]]+$/, "", value)
      sub(/^"/, "", value)
      sub(/"$/, "", value)
      return value
    }

    function save_entry() {
      if (entry_name != "" && entry_namespace != "") {
        namespaces[entry_name] = entry_namespace
      }
    }

    /^[[:space:]]*current-context:[[:space:]]*/ {
      value = $0
      sub(/^[[:space:]]*current-context:[[:space:]]*/, "", value)
      current = clean(value)
      next
    }

    /^[[:space:]]*contexts:[[:space:]]*$/ {
      in_contexts = 1
      next
    }

    in_contexts && /^[^[:space:]-]/ {
      save_entry()
      in_contexts = 0
      entry_name = ""
      entry_namespace = ""
    }

    in_contexts && /^[[:space:]]*-[[:space:]]*/ {
      save_entry()
      entry_name = ""
      entry_namespace = ""
    }

    in_contexts && /^[[:space:]]*namespace:[[:space:]]*/ {
      value = $0
      sub(/^[[:space:]]*namespace:[[:space:]]*/, "", value)
      entry_namespace = clean(value)
    }

    in_contexts && /^[[:space:]]*(-[[:space:]]*)?name:[[:space:]]*/ {
      value = $0
      sub(/^[[:space:]]*(-[[:space:]]*)?name:[[:space:]]*/, "", value)
      entry_name = clean(value)
    }

    END {
      save_entry()
      if (current != "") {
        if (namespaces[current] != "") {
          print current "/" namespaces[current]
        } else {
          print current
        }
      }
    }
  ' "$1"
}

sc_helper_bashrc_kube() {
  local cache_age cache_seconds columns kube_file kube_label now

  SC_BASHRC_KUBE_CONFIG_FILE=""
  sc_helper_bashrc_kube_config_file >/dev/null || return 0
  kube_file="${SC_BASHRC_KUBE_CONFIG_FILE}"
  [ -n "${kube_file}" ] || return 0
  now="${SECONDS:-0}"
  cache_seconds="${SC_BASHRC_KUBE_CACHE_SECONDS:-5}"
  case "${cache_seconds}" in
    ""|*[!0-9]*) cache_seconds=5 ;;
  esac

  if [ "${SC_BASHRC_KUBE_CACHE_FILE:-}" = "${kube_file}" ] && [ -n "${SC_BASHRC_KUBE_CACHE_AT:-}" ]; then
    cache_age=$((now - SC_BASHRC_KUBE_CACHE_AT))
    if [ "${cache_age}" -ge 0 ] && [ "${cache_age}" -lt "${cache_seconds}" ]; then
      kube_label="${SC_BASHRC_KUBE_CACHE_LABEL:-}"
    fi
  fi

  if [ -z "${kube_label+x}" ]; then
    kube_label="$(sc_helper_bashrc_kube_label_from_file "${kube_file}")"
    SC_BASHRC_KUBE_CACHE_FILE="${kube_file}"
    SC_BASHRC_KUBE_CACHE_AT="${now}"
    SC_BASHRC_KUBE_CACHE_LABEL="${kube_label}"
  fi

  [ -n "${kube_label}" ] || return 0

  columns="${COLUMNS:-80}"
  case "${columns}" in
    ""|*[!0-9]*) columns=80 ;;
  esac
  [ "${columns}" -gt 1 ] || columns=80

  if [ "${#kube_label}" -ge "${columns}" ]; then
    kube_label="${kube_label:0:$((columns - 1))}"
  fi

  printf "%*s\r" "$((columns - 1))" "${kube_label}"
}


  if command -v kustomize >/dev/null 2>&1; then
    VKU=$(kustomize version --short 2>/dev/null | grep -oE 'v?[0-9]+(\.[0-9]+)+' | head -1 | sed 's/^v//')
    [ -n "$VKU" ] || VKU=$(kustomize version 2>/dev/null | grep -oE 'v?[0-9]+(\.[0-9]+)+' | head -1 | sed 's/^v//')

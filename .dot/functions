  if [ "${mode}" = "controllers" ] && [ -z "${namespace}" ]; then
    namespace="$(command kubectl config view --minify -o jsonpath='{.contexts[0].context.namespace}' 2>/dev/null)"
    [ -n "${namespace}" ] || namespace="default"
  fi

  rows="$({
    set -o pipefail
    if [ "${mode}" = "controllers" ]; then
      printf '%s\n' '{}'
      command kubectl get deployments.apps,statefulsets.apps,daemonsets.apps,replicasets.apps,pods \
        -n "${namespace}" -o json
    else
      command kubectl get nodes -o json \
        && command kubectl get pods --all-namespaces -o json
    fi | command jq -r -s --arg mode "${mode}" '
      def cpu_m:
        (. // "0" | tostring) as $q
        | if $q | endswith("n") then ($q[0:-1] | tonumber) / 1000000
          elif $q | endswith("u") then ($q[0:-1] | tonumber) / 1000
          elif $q | endswith("m") then ($q[0:-1] | tonumber)
          else ($q | tonumber) * 1000
          end;

      def memory_bytes:
        (. // "0" | tostring) as $q
        | if $q | endswith("Ei") then ($q[0:-2] | tonumber) * 1152921504606846976
          elif $q | endswith("Pi") then ($q[0:-2] | tonumber) * 1125899906842624
          elif $q | endswith("Ti") then ($q[0:-2] | tonumber) * 1099511627776
          elif $q | endswith("Gi") then ($q[0:-2] | tonumber) * 1073741824
          elif $q | endswith("Mi") then ($q[0:-2] | tonumber) * 1048576
          elif $q | endswith("Ki") then ($q[0:-2] | tonumber) * 1024
          elif $q | endswith("E") then ($q[0:-1] | tonumber) * 1000000000000000000
          elif $q | endswith("P") then ($q[0:-1] | tonumber) * 1000000000000000
          elif $q | endswith("T") then ($q[0:-1] | tonumber) * 1000000000000
          elif $q | endswith("G") then ($q[0:-1] | tonumber) * 1000000000
          elif $q | endswith("M") then ($q[0:-1] | tonumber) * 1000000
          elif $q | endswith("K") then ($q[0:-1] | tonumber) * 1000
          elif $q | endswith("m") then ($q[0:-1] | tonumber) / 1000
          else ($q | tonumber)
          end;

      def container_cpu($container; $kind):
        (((($container.resources // {})[$kind] // {}).cpu // "0") | cpu_m);

      def container_memory($container; $kind):
        (((($container.resources // {})[$kind] // {}).memory // "0") | memory_bytes);

      def summed_cpu($containers; $kind):
        reduce $containers[] as $container (0; . + container_cpu($container; $kind));

      def summed_memory($containers; $kind):
        reduce $containers[] as $container (0; . + container_memory($container; $kind));

      def container_pod_cpu($pod; $kind):
        (summed_cpu(($pod.spec.containers // []); $kind)) as $running
        | reduce ($pod.spec.initContainers // [])[] as $container (
            {running: $running, restartable: 0, init_max: 0};
            (container_cpu($container; $kind)) as $value
            | if $container.restartPolicy == "Always" then
                .running += $value
                | .restartable += $value
                | .init_max = ([.init_max, .restartable] | max)
              else
                .init_max = ([.init_max, (.restartable + $value)] | max)
              end
          )
        | [.running, .init_max] | max;

      def container_pod_memory($pod; $kind):
        (summed_memory(($pod.spec.containers // []); $kind)) as $running
        | reduce ($pod.spec.initContainers // [])[] as $container (
            {running: $running, restartable: 0, init_max: 0};
            (container_memory($container; $kind)) as $value
            | if $container.restartPolicy == "Always" then
                .running += $value
                | .restartable += $value
                | .init_max = ([.init_max, .restartable] | max)
              else
                .init_max = ([.init_max, (.restartable + $value)] | max)
              end
          )
        | [.running, .init_max] | max;

      def pod_cpu($pod; $kind):
        (((($pod.spec.resources // {})[$kind] // {}).cpu // null)) as $pod_level
        | (if $pod_level != null then ($pod_level | cpu_m)
           else container_pod_cpu($pod; $kind)
           end) as $value
        | if $kind == "limits" and $value == 0 then 0
          else $value + (($pod.spec.overhead.cpu // "0") | cpu_m)
          end;

      def pod_memory($pod; $kind):
        (((($pod.spec.resources // {})[$kind] // {}).memory // null)) as $pod_level
        | (if $pod_level != null then ($pod_level | memory_bytes)
           else container_pod_memory($pod; $kind)
           end) as $value
        | if $kind == "limits" and $value == 0 then 0
          else $value + (($pod.spec.overhead.memory // "0") | memory_bytes)
          end;

      def empty_usage:
        {cpu_request: 0, cpu_limit: 0, memory_request: 0, memory_limit: 0, pods: 0};

      def controller_owner($object):
        [($object.metadata.ownerReferences // [])[] | select(.controller == true)][0] // null;

      def workload_key($pod; $replica_sets):
        controller_owner($pod) as $owner
        | if $owner == null then null
          elif $owner.kind == "ReplicaSet" then
            ($replica_sets[$owner.name] // null) as $deployment
            | if $deployment == null then null else "Deployment/\($deployment)" end
          elif $owner.kind == "StatefulSet" or $owner.kind == "DaemonSet" then
            "\($owner.kind)/\($owner.name)"
          else null
          end;

      if $mode == "nodes" then
        .[0] as $nodes
        | .[1] as $pods
        | reduce (
            $pods.items[]
            | select((.spec.nodeName // "") != "")
            | select(.status.phase != "Succeeded" and .status.phase != "Failed")
          ) as $pod ({};
            ($pod.spec.nodeName) as $node
            | (.[$node] // empty_usage) as $current
            | .[$node] = {
                cpu_request: ($current.cpu_request + pod_cpu($pod; "requests")),
                cpu_limit: ($current.cpu_limit + pod_cpu($pod; "limits")),
                memory_request: ($current.memory_request + pod_memory($pod; "requests")),
                memory_limit: ($current.memory_limit + pod_memory($pod; "limits")),
                pods: ($current.pods + 1)
              }
          ) as $usage
        | [
            $nodes.items[]
            | . as $node
            | ($usage[$node.metadata.name] // empty_usage) as $used
            | $used + {
                node: $node.metadata.name,
                cpu_allocatable: (($node.status.allocatable.cpu // "0") | cpu_m),
                memory_allocatable: (($node.status.allocatable.memory // "0") | memory_bytes)
              }
          ] | sort_by(.node) as $node_rows
        | ({
            node: "*",
            cpu_request: ($node_rows | map(.cpu_request) | add // 0),
            cpu_limit: ($node_rows | map(.cpu_limit) | add // 0),
            memory_request: ($node_rows | map(.memory_request) | add // 0),
            memory_limit: ($node_rows | map(.memory_limit) | add // 0),
            cpu_allocatable: ($node_rows | map(.cpu_allocatable) | add // 0),
            memory_allocatable: ($node_rows | map(.memory_allocatable) | add // 0),
            pods: ($node_rows | map(.pods) | add // 0)
          } as $cluster
          | [$cluster] + $node_rows)
        | .[]
        | [
            .node,
            .cpu_request,
            .memory_request,
            .cpu_limit,
            .memory_limit,
            .cpu_allocatable,
            .memory_allocatable,
            .pods
          ]
        | @tsv
      else
        .[1] as $resources
        | reduce (
            $resources.items[]
            | select(.kind == "ReplicaSet")
          ) as $replica_set ({};
            controller_owner($replica_set) as $owner
            | if $owner != null and $owner.kind == "Deployment" then
                .[$replica_set.metadata.name] = $owner.name
              else .
              end
          ) as $replica_sets
        | reduce (
            $resources.items[]
            | select(.kind == "Deployment" or .kind == "StatefulSet" or .kind == "DaemonSet")
          ) as $workload ({};
            .["\($workload.kind)/\($workload.metadata.name)"] = (
              empty_usage + {kind: $workload.kind, name: $workload.metadata.name}
            )
          ) as $workloads
        | reduce (
            $resources.items[]
            | select(.kind == "Pod")
            | select(.status.phase != "Succeeded" and .status.phase != "Failed")
          ) as $pod ($workloads;
            workload_key($pod; $replica_sets) as $key
            | if $key == null or .[$key] == null then .
              else
                .[$key].cpu_request += pod_cpu($pod; "requests")
                | .[$key].cpu_limit += pod_cpu($pod; "limits")
                | .[$key].memory_request += pod_memory($pod; "requests")
                | .[$key].memory_limit += pod_memory($pod; "limits")
                | .[$key].pods += 1
              end
          )
        | to_entries
        | map(.value)
        | sort_by(.kind, .name)
        | .[]
        | [
            .kind,
            .name,
            .pods,
            .cpu_request,
            .memory_request,
            .cpu_limit,
            .memory_limit
          ]
        | @tsv
      end
    '
  })" || {
    printf '%s\n' 'Could not read Kubernetes resources' >&2
    return 1
  }

  if [ "${mode}" = "controllers" ]; then
    printf 'Namespace: %s\n\n' "${namespace}"
  fi

  {
    if [ "${mode}" = "controllers" ]; then
      printf 'KIND\tNAME\tPODS\tCPU REQUESTS\tMEMORY REQUESTS\tCPU LIMITS\tMEMORY LIMITS\n'
    else
      printf 'NODE\tCPU REQUESTS\tMEMORY REQUESTS\tCPU LIMITS\tMEMORY LIMITS\tPODS\n'
    fi
    if [ -n "${rows}" ]; then
      printf '%s\n' "${rows}" | awk -F '\t' -v mode="${mode}" '
      function trim_decimal(value) {
        sub(/[.]00$/, "", value)
        if (value ~ /[.]/) {
          sub(/0$/, "", value)
          sub(/[.]$/, "", value)
        }
        return value
      }
      function cpu(value) {
        if (value == 0) return "0"
        if (value < 1000) return sprintf("%.0fm", value)
        return trim_decimal(sprintf("%.2f", value / 1000))
      }
      function memory(value) {
        if (value == 0) return "0"
        if (value >= 1099511627776) return trim_decimal(sprintf("%.2f", value / 1099511627776)) "Ti"
        if (value >= 1073741824) return trim_decimal(sprintf("%.2f", value / 1073741824)) "Gi"
        if (value >= 1048576) return trim_decimal(sprintf("%.2f", value / 1048576)) "Mi"
        if (value >= 1024) return trim_decimal(sprintf("%.2f", value / 1024)) "Ki"
        return sprintf("%.0fB", value)
      }
      function percentage(value, total) {
        if (total <= 0) return "-"
        return sprintf("%.0f%%", value * 100 / total)
      }
      BEGIN { OFS = "\t" }
      {
        if (mode == "controllers") {
          print $1, $2, $3, cpu($4), memory($5), cpu($6), memory($7)
        } else {
          print $1,
            cpu($2) " (" percentage($2, $6) ")",
            memory($3) " (" percentage($3, $7) ")",
            cpu($4) " (" percentage($4, $6) ")",
            memory($5) " (" percentage($5, $7) ")",
            $8
        }
      }
      '
    fi
  } | sc_helper_tsv_table
}

sc_helper_tsv_table() {
  if command -v column >/dev/null 2>&1; then
    column -t -s "$(printf '\t')"
    return
  fi

  awk -F '\t' '
    {
      rows[NR] = $0
      if (NF > max_fields) {
        max_fields = NF
      }
      for (i = 1; i <= NF; i++) {
        cells[NR, i] = $i
        if (length($i) > widths[i]) {
          widths[i] = length($i)
        }
      }
    }
    END {
      for (row = 1; row <= NR; row++) {
        for (i = 1; i <= max_fields; i++) {
          if (i == max_fields) {
            printf "%s", cells[row, i]
          } else {
            fmt = "%-" (widths[i] + 2) "s"
            printf fmt, cells[row, i]
          }
        }
        printf "\n"
      }
    }
  '
}

sc_helper_kube_secret() {
  if ! command -v kubectl >/dev/null 2>&1; then
    echo "kubectl not found" 1>&2
    return 127
  fi
  if ! command -v jq >/dev/null 2>&1; then
    echo "jq not found" 1>&2
    return 127
  fi

  local ns secret
  case "${1:-}" in
    -n|--namespace)
      ns="${2:-}"
      secret="${3:-}"
      ;;
    -h|--help|"")
      echo "Usage: ksecret [-n namespace] <secret>"
      return 0
      ;;
    *)
      secret="${1}"
      ns="$(kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null)"
      [ -n "${ns}" ] || ns=default
      ;;
  esac

  if [ -z "${ns}" ] || [ -z "${secret}" ]; then
    echo "Usage: ksecret [-n namespace] <secret>" 1>&2
    return 2
  fi

  kubectl get secret "${secret}" -n "${ns}" -o json \
    | jq -r '.data | to_entries[] | "\(.key): \(.value | @base64d)"'
}

sc_helper_kube_containers() {
  if ! command -v kubectl >/dev/null 2>&1; then
    echo "kubectl not found" 1>&2
    return 127
  fi
  if ! command -v jq >/dev/null 2>&1; then
    echo "jq not found" 1>&2
    return 127
  fi

  local ns pod pods_json rows

  case "${1:-}" in
    -n|--namespace)
      ns="${2:-}"
      pod="${3:-}"
      ;;
    -h|--help)
      echo "Usage: k get containers [-n namespace] [pod]"
      return 0
      ;;
    *)
      pod="${1:-}"
      ns="$(kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null)"
      [ -n "${ns}" ] || ns=default
      ;;
  esac

  if [ -z "${ns}" ]; then
    echo "Usage: k get containers [-n namespace] [pod]" 1>&2
    return 2
  fi

  if [ -n "${pod}" ]; then
    pods_json="$(kubectl get pod "${pod}" -n "${ns}" -o json 2>/dev/null)" || {
      echo "Pod '${pod}' not found in namespace '${ns}'" 1>&2
      return 1
    }
  else
    pods_json="$(kubectl get pods -n "${ns}" -o json 2>/dev/null)" || {
      echo "Could not list pods in namespace '${ns}'" 1>&2
      return 1
    }
  fi

  rows="$(
    printf "%s" "${pods_json}" | jq -r '
      def state_row:
        if .state.running then
          ["running", "-"]
        elif .state.waiting then
          ["waiting", (.state.waiting.reason // "-")]
        elif .state.terminated then
          ["terminated", (.state.terminated.reason // ("exit " + ((.state.terminated.exitCode // 0) | tostring)))]
        else
          ["-", "-"]
        end;
      (if has("items") then .items[] else . end) as $pod
      | (
          (($pod.status.initContainerStatuses // [])[] | ["init", .]),
          (($pod.status.containerStatuses // [])[] | ["container", .])
        )
      | .[0] as $type
      | .[1] as $container
      | ($container | state_row) as $state
      | (if $type == "init" then "i" else "c" end) as $type_suffix
      | [
          ($pod.metadata.name // "-"),
          (($container.name // "-") + "(" + $type_suffix + ")"),
          $state[0],
          $state[1],
          (($container.restartCount // 0) | tostring)
        ]
      | @tsv
    '
  )"

  if [ -z "${rows}" ]; then
    if [ -n "${pod}" ]; then
      echo "No containers found for pod '${pod}' in namespace '${ns}'"
    else
      echo "No containers found in namespace '${ns}'"
    fi
    return 0
  fi

  {
    printf "POD\tCONTAINER\tSTATE\tREASON\tRESTARTS\n"
    printf "%s\n" "${rows}"
  } | sc_helper_tsv_table
}

sc_helper_kube_error_log_try() {
  local log_ns="$1"
  local log_pod="$2"
  local log_container="$3"
  local log_mode="$4"
  local log_tail="$5"
  local log_since="$6"
  local log_pod_width="$7"
  local log_container_width="$8"
  local log_container_label="$9"
  local log_line
  local log_output
  local log_status
  local -a log_args

  log_args=(-n "${log_ns}" "${log_pod}" -c "${log_container}")
  if [ "${log_mode}" = "previous" ]; then
    log_args+=(--previous)
  fi
  [ -z "${log_since}" ] || log_args+=(--since="${log_since}")
  [ -z "${log_tail}" ] || log_args+=(--tail="${log_tail}")

  log_output="$(kubectl logs "${log_args[@]}" 2>&1)"
  log_status=$?

  [ "${log_status}" -eq 0 ] || return 1
  case "${log_output}" in
    "Error from server"*|error:*|*"unable to retrieve container logs"*|*"previous terminated container"*|*"is waiting to start"*)
      return 1
      ;;
  esac

  if [ -n "${log_output}" ]; then
    while IFS= read -r log_line; do
      printf "%-${log_pod_width}s  %-${log_container_width}s  %s\n" "${log_pod}" "${log_container_label}" "${log_line}"
    done <<EOF
${log_output}
EOF
  else
    printf "%-${log_pod_width}s  %-${log_container_width}s  %s\n" "${log_pod}" "${log_container_label}" "(no logs)"
  fi
  return 0
}

sc_helper_kube_error_logs() {
  local rows="$1"
  local log_tail="$2"
  local log_mode="${3:-current}"
  local log_since="$4"
  local log_ns log_pod log_container log_type log_state log_reason log_restarts log_container_label
  local log_pod_width=3 log_container_width=9

  while IFS=$'\t' read -r log_ns log_pod log_container log_type log_state log_reason log_restarts; do
    [ -n "${log_pod}" ] || continue
    if [ "${log_type}" = "init" ]; then
      log_container_label="${log_container}(i)"
    else
      log_container_label="${log_container}(c)"
    fi
    [ "${#log_pod}" -le "${log_pod_width}" ] || log_pod_width="${#log_pod}"
    [ "${#log_container_label}" -le "${log_container_width}" ] || log_container_width="${#log_container_label}"
  done <<EOF
${rows}
EOF

  printf "%-${log_pod_width}s  %-${log_container_width}s  %s\n" "POD" "CONTAINER" "LOG"
  while IFS=$'\t' read -r log_ns log_pod log_container log_type log_state log_reason log_restarts; do
    [ -n "${log_pod}" ] || continue
    if [ "${log_type}" = "init" ]; then
      log_container_label="${log_container}(i)"
    else
      log_container_label="${log_container}(c)"
    fi

    sc_helper_kube_error_log_try "${log_ns}" "${log_pod}" "${log_container}" "${log_mode}" "${log_tail}" "${log_since}" "${log_pod_width}" "${log_container_width}" "${log_container_label}" \
      || printf "%-${log_pod_width}s  %-${log_container_width}s  %s\n" "${log_pod}" "${log_container_label}" "logs unavailable"
  done <<EOF
${rows}
EOF
}

sc_helper_kube_error_log_sorted_try() {
  local log_ns="$1"
  local log_pod="$2"
  local log_container="$3"
  local log_mode="$4"
  local log_tail="$5"
  local log_since="$6"
  local log_container_label="$7"
  local log_line log_output log_status log_ts log_msg
  local -a log_args

  log_args=(-n "${log_ns}" "${log_pod}" -c "${log_container}" --timestamps)
  if [ "${log_mode}" = "previous" ]; then
    log_args+=(--previous)
  fi
  [ -z "${log_since}" ] || log_args+=(--since="${log_since}")
  [ -z "${log_tail}" ] || log_args+=(--tail="${log_tail}")

  log_output="$(kubectl logs "${log_args[@]}" 2>&1)"
  log_status=$?

  [ "${log_status}" -eq 0 ] || return 1
  case "${log_output}" in
    "Error from server"*|error:*|*"unable to retrieve container logs"*|*"previous terminated container"*|*"is waiting to start"*)
      return 1
      ;;
  esac
  [ -n "${log_output}" ] || return 1

  while IFS= read -r log_line; do
    [ -n "${log_line}" ] || continue
    log_ts="${log_line%% *}"
    log_msg="${log_line#* }"
    [ "${log_msg}" != "${log_line}" ] || log_msg=""
    log_msg="${log_msg//$'\t'/ }"
    printf "%s\t%s\t%s\t%s\n" "${log_ts}" "${log_pod}" "${log_container_label}" "${log_msg}"
  done <<EOF
${log_output}
EOF
}

sc_helper_kube_error_logs_sorted() {
  local rows="$1"
  local log_tail="$2"
  local log_mode="${3:-current}"
  local log_since="$4"
  local log_ns log_pod log_container log_type log_state log_reason log_restarts log_container_label
  local log_rows

  log_rows="$(
    while IFS=$'\t' read -r log_ns log_pod log_container log_type log_state log_reason log_restarts; do
      [ -n "${log_pod}" ] || continue
      if [ "${log_type}" = "init" ]; then
        log_container_label="${log_container}(i)"
      else
        log_container_label="${log_container}(c)"
      fi
      sc_helper_kube_error_log_sorted_try "${log_ns}" "${log_pod}" "${log_container}" "${log_mode}" "${log_tail}" "${log_since}" "${log_container_label}" || true
    done <<EOF
${rows}
EOF
  )"

  if [ -z "${log_rows}" ]; then
    echo "No logs found for failing containers"
    return 0
  fi

  {
    printf "TIME\tPOD\tCONTAINER\tLOG\n"
    printf "%s\n" "${log_rows}" | LC_ALL=C sort
  } | sc_helper_tsv_table
}

sc_helper_kube_errors() {
  if ! command -v kubectl >/dev/null 2>&1; then
    echo "kubectl not found" 1>&2
    return 127
  fi
  if ! command -v jq >/dev/null 2>&1; then
    echo "jq not found" 1>&2
    return 127
  fi

  local all=0 ns="" pod="" pods_json rows scope show_logs=0 log_tail="" log_since="" log_mode="current" log_sort=0

  while [ "$#" -gt 0 ]; do
    case "${1}" in
      -A|--all-namespaces)
        all=1
        shift
        ;;
      -n|--namespace)
        ns="${2:-}"
        if [ -z "${ns}" ]; then
          echo "Usage: kerrors [-A] [-n namespace] [pod]" 1>&2
          return 2
        fi
        shift 2
        ;;
      -l|--logs)
        show_logs=1
        shift
        ;;
      -p|--previous)
        log_mode="previous"
        shift
        ;;
      --sort)
        log_sort=1
        shift
        ;;
      -s|--since)
        log_since="${2:-}"
        if [ -z "${log_since}" ]; then
          echo "Usage: kerrors [-A] [-n namespace] [--logs] [--sort] [-p|--previous] [-s|--since duration] [--tail lines] [pod]" 1>&2
          return 2
        fi
        shift 2
        ;;
      --since=*)
        log_since="${1#--since=}"
        if [ -z "${log_since}" ]; then
          echo "Usage: kerrors [-A] [-n namespace] [--logs] [--sort] [-p|--previous] [-s|--since duration] [--tail lines] [pod]" 1>&2
          return 2
        fi
        shift
        ;;
      --tail)
        log_tail="${2:-}"
        if ! [[ "${log_tail}" =~ ^[0-9]+$ ]]; then
          echo "Usage: kerrors [-A] [-n namespace] [--logs] [--sort] [-p|--previous] [-s|--since duration] [--tail lines] [pod]" 1>&2
          return 2
        fi
        shift 2
        ;;
      --tail=*)
        log_tail="${1#--tail=}"
        if ! [[ "${log_tail}" =~ ^[0-9]+$ ]]; then
          echo "Usage: kerrors [-A] [-n namespace] [--logs] [--sort] [-p|--previous] [-s|--since duration] [--tail lines] [pod]" 1>&2
          return 2
        fi
        shift
        ;;
      -h|--help)
        echo "Usage: kerrors [-A] [-n namespace] [--logs] [--sort] [-p|--previous] [-s|--since duration] [--tail lines] [pod]"
        return 0
        ;;
      -*)
        echo "Usage: kerrors [-A] [-n namespace] [--logs] [--sort] [-p|--previous] [-s|--since duration] [--tail lines] [pod]" 1>&2
        return 2
        ;;
      *)
        if [ -z "${pod}" ]; then
          pod="${1}"
          shift
        else
          echo "Usage: kerrors [-A] [-n namespace] [--logs] [--sort] [-p|--previous] [-s|--since duration] [--tail lines] [pod]" 1>&2
          return 2
        fi
        ;;
    esac
  done

  if [ "${all}" -eq 1 ]; then
    scope="all namespaces"
    pods_json="$(kubectl get pods -A -o json 2>/dev/null)" || return 1
  else
    if [ -z "${ns}" ]; then
      ns="$(kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null)"
      [ -n "${ns}" ] || ns=default
    fi
    scope="namespace ${ns}"
    pods_json="$(kubectl get pods -n "${ns}" -o json 2>/dev/null)" || return 1
  fi
  [ -z "${pod}" ] || scope="${scope}, pod ${pod}"

  rows="$(
    printf "%s" "${pods_json}" | jq -r --arg pod "${pod}" '
      def bad_reason:
        "CrashLoopBackOff|ImagePullBackOff|ErrImagePull|CreateContainerConfigError|CreateContainerError|InvalidImageName|RunContainerError|Error";
      def current_bad:
        ((.state.waiting.reason? // "") | test(bad_reason))
        or ((.state.terminated.exitCode? // 0) != 0);
      def previous_bad:
        ((.lastState.terminated.exitCode? // 0) != 0);
      def recovered_bad:
        ((.restartCount // 0) > 0)
        and ((.state.terminated.exitCode? // 1) == 0);
      def pod_ready:
        ((.status.conditions // []) | any(.type == "Ready" and .status == "True"));
      def state_row:
        if current_bad then
          if .state.waiting then
            ["waiting", (.state.waiting.reason // "-")]
          elif .state.terminated then
            ["terminated", ((.state.terminated.reason // ("exit " + ((.state.terminated.exitCode // 0) | tostring))))]
          else
            empty
          end
        elif previous_bad then
          ["last-terminated", ((.lastState.terminated.reason // ("exit " + ((.lastState.terminated.exitCode // 0) | tostring))))]
        elif recovered_bad then
          ["recovered", "CompletedAfterRestart"]
        else
          empty
        end;
      .items[]
      | select($pod == "" or .metadata.name == $pod)
      | . as $pod
      | ($pod | pod_ready) as $pod_ready
      | (
          (($pod.status.initContainerStatuses // [])[] | ["init", .]),
          (($pod.status.containerStatuses // [])[] | ["container", .])
        )
      | .[0] as $type
      | .[1] as $container
      | select($container | (current_bad or (($pod_ready | not) and (previous_bad or recovered_bad))))
      | ($container | state_row) as $state
      | [
          ($pod.metadata.namespace // "-"),
          ($pod.metadata.name // "-"),
          ($container.name // "-"),
          $type,
          $state[0],
          $state[1],
          (($container.restartCount // 0) | tostring)
        ]
      | @tsv
    '
  )"

  if [ -z "${rows}" ]; then
    echo "No failing pods found in ${scope}"
    return 0
  fi

  if [ "${show_logs}" -eq 1 ]; then
    if [ "${log_sort}" -eq 1 ]; then
      sc_helper_kube_error_logs_sorted "${rows}" "${log_tail}" "${log_mode}" "${log_since}"
    else
      sc_helper_kube_error_logs "${rows}" "${log_tail}" "${log_mode}" "${log_since}"
    fi
  elif [ "${all}" -eq 1 ]; then
    {
      printf "NAMESPACE\tPOD\tCONTAINER\tSTATE\tREASON\tRESTARTS\n"
      printf "%s\n" "${rows}" | awk -F '\t' 'BEGIN { OFS="\t" } {
        suffix = ($4 == "init" ? "(i)" : "(c)")
        print $1, $2, $3 suffix, $5, $6, $7
      }'
    } | sc_helper_tsv_table
  else
    {
      printf "POD\tCONTAINER\tSTATE\tREASON\tRESTARTS\n"
      printf "%s\n" "${rows}" | awk -F '\t' 'BEGIN { OFS="\t" } {
        suffix = ($4 == "init" ? "(i)" : "(c)")
        print $2, $3 suffix, $5, $6, $7
      }'
    } | sc_helper_tsv_table
  fi
}


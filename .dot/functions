sc_helper_git_scan_table() {
  local color_enabled="${1:-0}"

  awk -F '\t' -v color_enabled="${color_enabled}" '
    {
      row_count++
      if (NF > column_count) {
        column_count = NF
      }
      for (column = 1; column <= NF; column++) {
        cells[row_count, column] = $column
        if (length($column) > widths[column]) {
          widths[column] = length($column)
        }
      }
    }
    END {
      red = sprintf("%c[31m", 27)
      reset = sprintf("%c[0m", 27)

      for (row = 1; row <= row_count; row++) {
        bad_uncommitted = (row > 1 && cells[row, 3] != "no")
        bad_unpushed = (row > 1 && cells[row, 4] != "no")
        bad_sync = (row > 1 && cells[row, 5] != "synced")
        repository_problem = (bad_uncommitted || bad_unpushed || bad_sync)

        for (column = 1; column <= column_count; column++) {
          raw = cells[row, column]
          rendered = raw

          if (color_enabled == 1 && row > 1) {
            if ((column == 1 && repository_problem) ||
                (column == 3 && bad_uncommitted) ||
                (column == 4 && bad_unpushed) ||
                (column == 5 && bad_sync)) {
              rendered = red raw reset
            }
          }

          printf "%s", rendered
          if (column < column_count) {
            for (padding = length(raw); padding < widths[column] + 2; padding++) {
              printf " "
            }
          }
        }
        printf "\n"
      }
    }
  '
}

sc_helper_git_scan() {
  local root="." color_enabled=0 fetch_requested=0
  local ahead behind branch directory directory_name fetch_failed sync uncommitted unpushed upstream

  case "${1:-}" in
    --fetch)
      fetch_requested=1
      shift
      ;;
    -h|--help)
      printf "Usage: git-scan [--fetch] [directory]\n"
      return 0
      ;;
    -*)
      printf "Usage: git-scan [--fetch] [directory]\n" >&2
      return 2
      ;;
  esac

  if [ "$#" -gt 1 ]; then
    printf "Usage: git-scan [--fetch] [directory]\n" >&2
    return 2
  fi
  root="${1:-.}"

  if [ ! -d "${root}" ]; then
    printf "Directory does not exist: %s\n" "${root}" >&2
    return 2
  fi

  if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    color_enabled=1
  fi

  {
    printf "DIRECTORY\tBRANCH\tUNCOMMITTED\tUNPUSHED\tSYNC\n"

    for directory in "${root}"/*/; do
      [ -d "${directory}" ] || continue
      directory="${directory%/}"
      directory_name="${directory##*/}"

      [ -e "${directory}/.git" ] || continue
      command git -C "${directory}" rev-parse --git-dir >/dev/null 2>&1 || continue

      fetch_failed=0
      if [ "${fetch_requested}" -eq 1 ]; then
        command git -C "${directory}" fetch --quiet >/dev/null 2>&1 || fetch_failed=1
      fi

      branch="$(command git -C "${directory}" symbolic-ref --quiet --short HEAD 2>/dev/null)"
      if [ -z "${branch}" ]; then
        branch="$(command git -C "${directory}" rev-parse --short HEAD 2>/dev/null)"
        branch="${branch:+detached@${branch}}"
        branch="${branch:-unborn}"
      fi

      if [ -n "$(command git -C "${directory}" status --porcelain=v1 --untracked-files=normal 2>/dev/null)" ]; then
        uncommitted="yes"
      else
        uncommitted="no"
      fi

      upstream="$(command git -C "${directory}" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)"
      if [ -z "${upstream}" ]; then
        unpushed="no-upstream"
        sync="no-upstream"
      else
        ahead="$(command git -C "${directory}" rev-list --count "${upstream}..HEAD" 2>/dev/null)"
        behind="$(command git -C "${directory}" rev-list --count "HEAD..${upstream}" 2>/dev/null)"
        case "${ahead}:${behind}" in
          *[!0-9:]*|:*|*:)
            unpushed="unknown"
            sync="unknown"
            ;;
          0:0)
            unpushed="no"
            sync="synced"
            ;;
          0:*)
            unpushed="no"
            sync="behind"
            ;;
          *:0)
            unpushed="yes"
            sync="ahead"
            ;;
          *)
            unpushed="yes"
            sync="diverged"
            ;;
        esac
      fi

      if [ "${fetch_failed}" -eq 1 ]; then
        sync="fetch-failed"
      fi

      printf "%s\t%s\t%s\t%s\t%s\n" \
        "${directory_name}" "${branch}" "${uncommitted}" "${unpushed}" "${sync}"
    done
  } | sc_helper_git_scan_table "${color_enabled}"
}


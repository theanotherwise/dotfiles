  else
    db_files+=(
      "${HOME}/.local/share/zoxide/db.zo"
      "${HOME}/Library/Application Support/zoxide/db.zo"
    )
  fi

  for db_file in "${db_files[@]}"; do
    [ -n "${db_file}" ] || continue
    [ -f "${db_file}" ] || continue
    rm -f "${db_file}"
    echo "zoxide database removed: ${db_file}"
    removed=1
  done

  [ "${removed}" -eq 1 ] || echo "zoxide database not found"

  if [ "$#" -eq 0 ]; then
    sc_helper_zseed "${HOME}"
  else
    sc_helper_zseed "$@"
  fi
}

sc_helper_zoxide_add_batch() {
  [ "$#" -gt 0 ] || return 0
  command zoxide add -s 1 "$@"
}

sc_helper_zseed_root() {
  local root="$1"
  local pattern root_dir extra_root status=0
  local batch_size="${SC_ZOXIDE_SEED_BATCH_SIZE:-500}"
  local -a find_prune_args
  local -a batch=()

  if [ ! -d "${root}" ]; then
    echo "Directory not found: ${root}" 1>&2
    return 1
  fi

  case "${batch_size}" in
    ''|*[!0-9]*)
      batch_size=500
      ;;
  esac
  [ "${batch_size}" -gt 0 ] || batch_size=500

  while IFS= read -r pattern; do
    [ -n "${pattern}" ] || continue
    [ "${#find_prune_args[@]}" -eq 0 ] || find_prune_args+=(-o)
    find_prune_args+=(-name "${pattern}")
  done < <(sc_helper_ignored_dir_patterns)

  while IFS= read -r extra_root; do
    [ -n "${extra_root}" ] || continue
    extra_root="${extra_root%/}"
    [ "${#find_prune_args[@]}" -eq 0 ] || find_prune_args+=(-o)
    find_prune_args+=(-path "${extra_root}" -o -path "${extra_root}/*")
  done < <(sc_helper_zoxide_extra_ignored_roots)

  while IFS= read -r -d '' root_dir; do
    batch+=("${root_dir}")
    if [ "${#batch[@]}" -ge "${batch_size}" ]; then
      sc_helper_zoxide_add_batch "${batch[@]}" || status=1
      batch=()
    fi
  done < <(
    find "${root}" \
      \( "${find_prune_args[@]}" \) -prune \
      -o -type d -print0 \
      2>/dev/null
  )

  if [ "${#batch[@]}" -gt 0 ]; then
    sc_helper_zoxide_add_batch "${batch[@]}" || status=1
  fi

  return "${status}"
}

sc_helper_zseed() {
  if ! command -v zoxide >/dev/null 2>&1; then
    echo "zoxide not found" 1>&2
    return 127
  fi

  local root status=0

  zoxide query -l 2>/dev/null \
    | while IFS= read -r dir; do
        if [ ! -d "${dir}" ] || sc_helper_zoxide_ignored_path "${dir}"; then
          command zoxide remove "${dir}"
        fi
      done

  [ "$#" -gt 0 ] || set -- "${HOME}"

  for root in "$@"; do
    sc_helper_zseed_root "${root}" || status=1
  done

  return "${status}"
}

sc_helper_zoxide_init() {
  command -v zoxide >/dev/null 2>&1 || return 0

  local zoxide_excludes
  zoxide_excludes="$(sc_helper_zoxide_exclude_dirs)"

  case ":${_ZO_EXCLUDE_DIRS:-}:" in
    *":${zoxide_excludes}:"*) ;;
    *) export _ZO_EXCLUDE_DIRS="${_ZO_EXCLUDE_DIRS:+${_ZO_EXCLUDE_DIRS}:}${zoxide_excludes}" ;;
  esac

  eval "$(zoxide init bash)"
  zoxide() {
    case "${1:-}" in
      ""|-*|add|edit|import|init|query|remove)
        command zoxide "$@"
        ;;
      *)
        command zoxide query "$@"
        ;;
    esac
  }
  z() {
    __zoxide_z "$@"
  }
  declare -F sc_helper_zoxide_z_completion >/dev/null 2>&1 && complete -F sc_helper_zoxide_z_completion z
  declare -F sc_helper_zoxide_completion >/dev/null 2>&1 && complete -F sc_helper_zoxide_completion zoxide
}


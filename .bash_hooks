if [[ -n "${SC_BASH_SHOW_LOADING:-}" ]]; then
  echo "Loading file: $(basename "${BASH_SOURCE[0]}")"
fi

case "$-" in
  *i*) ;;
  *) return 0 ;;
esac

if [[ "${__sc_bash_hooks_loaded:-}" == "1" ]]; then
  return 0
fi
__sc_bash_hooks_loaded=1

declare -a precmd_functions
declare -a preexec_functions

# Compatibility surface for CLIs that look for bash-preexec-style hook support.
bash_preexec_imported=sc-bash-hooks
__bp_imported=sc-bash-hooks
__bp_last_ret_value=0
__bp_last_argument_prev_command=

__bp_set_ret_value() {
  case "${1:-0}" in
    ''|*[!0-9]*) return 0 ;;
    *) return "${1}" ;;
  esac
}

__sc_bash_hooks_last_status=0
__sc_bash_hooks_ready=0
__sc_bash_hooks_in_prompt=0

__sc_bash_hooks_set_ret_value() {
  __bp_set_ret_value "$@"
}

__sc_bash_hooks_command_from_history() {
  local command

  command=$(
    HISTTIMEFORMAT='' builtin history 1 2>/dev/null
  )
  while [[ "${command}" == " "* ]]; do
    command="${command# }"
  done
  while [[ "${command}" == [0-9]* ]]; do
    command="${command#?}"
  done
  case "${command}" in
    " "*)
      command="${command# }"
      ;;
    "*"*)
      command="${command#\*}"
      ;;
  esac
  case "${command}" in
    " "*)
      command="${command# }"
      ;;
  esac

  if [[ -n "${command}" ]]; then
    printf '%s\n' "${command}"
  else
    printf '%s\n' "${BASH_COMMAND}"
  fi
}

__sc_bash_hooks_run_preexec() {
  local status=$?
  local command fn

  __bp_last_ret_value="${status}"
  __bp_last_argument_prev_command="${_:-}"

  case "${BASH_COMMAND}" in
    __sc_bash_hooks_run_precmd*)
      __sc_bash_hooks_last_status="${status}"
      return 0
      ;;
  esac

  [[ "${__sc_bash_hooks_ready}" == "1" ]] || return 0
  [[ "${__sc_bash_hooks_in_prompt}" == "0" ]] || return 0

  case "${BASH_COMMAND}" in
    __sc_bash_hooks_*|__atuin_history*|__atuin_widget_run*|__atuin_bash42_dispatch*)
      return 0
      ;;
  esac

  __sc_bash_hooks_ready=0
  command="$(__sc_bash_hooks_command_from_history)"

  [[ -n "${command}" ]] || return 0
  for fn in "${preexec_functions[@]:-}"; do
    if declare -F "${fn}" >/dev/null 2>&1; then
      __sc_bash_hooks_set_ret_value "${status}" "${__bp_last_argument_prev_command}"
      "${fn}" "${command}"
    fi
  done

  # A non-zero DEBUG trap result tells Bash to skip the command it was about
  # to run. Always succeed here; the original status is carried separately.
  return 0
}

__sc_bash_hooks_run_precmd() {
  local status fn

  status="${__sc_bash_hooks_last_status}"
  __bp_last_ret_value="${status}"
  __bp_last_argument_prev_command="${_:-}"
  __sc_bash_hooks_in_prompt=1

  for fn in "${precmd_functions[@]:-}"; do
    if declare -F "${fn}" >/dev/null 2>&1; then
      __sc_bash_hooks_set_ret_value "${status}"
      "${fn}"
    fi
  done

  # Persist this shell's new commands and import commands appended by other
  # open shells so native Bash history stays consistent across terminal tabs.
  builtin history -a
  builtin history -n

  return "${status}"
}

__sc_bash_hooks_finish_prompt() {
  __sc_bash_hooks_in_prompt=0
  __sc_bash_hooks_ready=1
  return 0
}

__sc_bash_hooks_install_prompt_command() {
  case ";${PROMPT_COMMAND:-};" in
    *__sc_bash_hooks_run_precmd*) ;;
    *)
      if [[ -n "${PROMPT_COMMAND:-}" ]]; then
        PROMPT_COMMAND="__sc_bash_hooks_run_precmd; ${PROMPT_COMMAND}; __sc_bash_hooks_finish_prompt"
      else
        PROMPT_COMMAND="__sc_bash_hooks_run_precmd; __sc_bash_hooks_finish_prompt"
      fi
      ;;
  esac
}

__sc_bash_hooks_install_prompt_command
trap '__sc_bash_hooks_run_preexec' DEBUG
